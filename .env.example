SUPABASE_URL=https://ityzgsczkgnsyupzxopo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
SUPABASE_STORAGE_BUCKET=firmware
SUPABASE_INSECURE_SSL=0

# Uebergangsphase: Erst nach Supabase-Migration und eingerichtetem Schluessel
# auf "required" setzen. "disabled" erzeugt weiterhin Legacy-Releases.
OTA_SIGNING_MODE=disabled

# Signaturkonfiguration (private Datei immer ausserhalb aller Git-Repositories)
OTA_SIGNING_KEY_ID=production-p256-replace-with-fingerprint
OTA_SIGNING_PRIVATE_KEY=/absolute/path/outside/git/production-private.pem
OTA_SIGNING_PUBLIC_KEY=/absolute/path/outside/git/production-public.pem
OTA_SIGNING_KEYCHAIN_SERVICE=de.campclimate.ota-signing
OTA_SIGNING_KEYCHAIN_ACCOUNT=production-p256-replace-with-fingerprint

# Bis die Sequenz direkt aus Basic/Central gelesen und im BIN validiert wird.
OTA_BASIC_RELEASE_SEQUENCE=
OTA_CENTRAL_RELEASE_SEQUENCE=

# Nur fuer einen bewusst kontrollierten Ausnahmefall. Produktionsstandard ist
# ein frischer Build aus den aktuellen Sources.
OTA_ALLOW_EXISTING_SIGNED_BIN=0
